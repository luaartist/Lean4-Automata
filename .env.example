# .env.example — copy to .env and fill in real values before running
# cp .env.example .env

# ── App / proxy ports ─────────────────────────────────────────────────────────
APP_PORT=8000
INGESTION_PORT=8001
NGINX_HTTP_PORT=8080

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=lean4_automata
POSTGRES_USER=lean4
POSTGRES_PASSWORD=lean4_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Database URL for asyncpg (used by the FastAPI app) ───────────────────────
# asyncpg DSN (note: asyncpg scheme, NOT sqlalchemy)
DATABASE_URL=postgresql+asyncpg://lean4:lean4_dev_password@localhost:5432/lean4_automata

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_string_here
JWT_ALGORITHM=HS256

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "production" to disable /docs, /redoc, /openapi.json
ENV=development

# ── Phase 2: workers + file watcher ──────────────────────────────────────────
LEAN_WATCH_ROOT=./lean-src
LEAN_PROJECT_ID=1
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
FLOWER_PORT=5555
